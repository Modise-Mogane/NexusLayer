# NexusLayer environment variables (example only - no real secrets here).
# Copy to .env for local development and fill in real values.

# Backend
# Host/port for the FastAPI dev server
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated list of allowed CORS origins for local development
CORS_ORIGINS=http://localhost:3000

# Frontend (Next.js). Place in frontend/.env.local
NEXT_PUBLIC_API_URL=http://localhost:8000

# AI (planned - not used yet, do not implement until a later task)
META_MODEL_API_KEY=
# META_MODEL_BASE_URL=
