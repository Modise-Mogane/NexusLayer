# NexusLayer environment variables (example only - no real secrets here).
# Copy to .env for local development and fill in real values.

# Backend
# Host/port for the FastAPI dev server
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated list of allowed CORS origins for local development
CORS_ORIGINS=http://localhost:3000
# Route selection policy: lowest_latency, highest_bandwidth,
# highest_reliability, lowest_cost, balanced
ROUTING_POLICY=lowest_latency
# Optional SQLite path override (tests use a temp file via NEXUS_DB_PATH)
# NEXUS_DB_PATH=./backend/var/nexuslayer.db

# Frontend (Next.js). Place in frontend/.env.local
NEXT_PUBLIC_API_URL=http://localhost:8000

# AI provider (backend only - never expose via NEXT_PUBLIC_*).
# Preferred names:
MODEL_API_KEY=
META_MODEL=
MODEL_BASE_URL=
# Back-compat alias for MODEL_API_KEY (deprecated, still accepted):
# META_MODEL_API_KEY=
# Provider selection: meta (default) or baseten.
# AI_PROVIDER=meta
# Baseten inference (OpenAI-compatible, https://inference.baseten.co/v1):
# BASETEN_API_KEY=
# BASETEN_MODEL=
